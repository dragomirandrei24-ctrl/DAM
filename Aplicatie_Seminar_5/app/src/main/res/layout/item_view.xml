<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/ramTextView_Holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RAM" />

    <TextView
        android:id="@+id/storageTextView_Holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Storage" />

    <TextView
        android:id="@+id/manufactureTextView_Holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manufacture" />

    <TextView
        android:id="@+id/purchaseDateTextView_Holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Purchase Date" />

    <CheckBox
        android:id="@+id/touchscreenCheckBox_Holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:text="Touchscreen" />

    <TextView
        android:id="@+id/extraOptionsTextView_Holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Extra Options" />
</LinearLayout>